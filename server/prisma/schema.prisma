// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  isMember  Boolean  @default(false)
  createdAt DateTime @default(now())
  bookshelf Bookshelf[]
  payments  Payment[]
  chatRooms  ChatRoom[]
  level     Int      @default(1)
}

enum BookStatus {
  BEFORE
  READING
  DONE
}

model Book {
  id        Int         @id @default(autoincrement())
  isbn      String      @unique
  title     String
  author    String
  imageUrl  String
  description String
  // 알라딘 배치 시딩 시 어떤 장르로 가져왔는지 저장(SEED_CATEGORIES의 name).
  // 네이버 검색으로 사용자가 직접 추가한 책은 장르 정보가 없어 null.
  category  String?
  createdAt DateTime    @default(now())
  bookshelf Bookshelf[]
}

model Bookshelf {
  id        Int        @id @default(autoincrement())
  userId    Int
  bookId    Int
  status    BookStatus
  createdAt DateTime   @default(now())

  comment   String?    // 한줄평
  phrase   String?    // 인상깊은 문장
  emotion   String?    // 감정
  startDate DateTime?  // 시작 날짜
  endDate   DateTime?  // 완료 날짜
  intent    String?
  sub    String?

  aiComment String?
  aiTags    String[]

  user User @relation(fields: [userId], references: [id])
  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
}

// 책 콘텐츠(제목/저자/설명)의 임베딩. 누가 읽었는지와 무관하게 책 자체에
// 귀속되는 값이라 유저 스코프를 두지 않음 — "누가 읽었는지"는 Bookshelf가 담당.
// 알라딘 배치 시딩으로 들어오는 책도 이 테이블에 그대로 합류함(공용 후보 풀).
model BookEmbedding {
  id        Int      @id @default(autoincrement())
  bookId    Int      @unique
  embedding Unsupported("vector(3072)")
  createdAt DateTime @default(now())
}

// 책 자체의 내용(제목/저자/설명)이 아니라, 사용자가 남긴 감상·감정을 임베딩.
// 책 내용 검색과 별도 신호로 둬서, "위로받은 책" 같은 감상 기반 질문도 벡터 검색에 걸리게 함.
model BookshelfEmbedding {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  embedding Unsupported("vector(3072)")
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
}

// 추천 화면(무드/취향/채팅)에서 실제로 사용자에게 보여준 책을 기록.
// "추천했더니 실제로 책장에 담겼는지"를 나중에 Bookshelf와 대조해 전환율을
// 계산하기 위한 로그 — userId는 로그인 없이도 호출 가능한 무드 추천 때문에 nullable
// (비로그인 요청은 이후 전환 여부를 추적할 방법이 없어 집계에서 제외됨).
model RecommendationLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  bookId    Int
  source    String   // 'mood' | 'taste' | 'chat'
  createdAt DateTime @default(now())

  @@index([userId, bookId])
  @@index([source])
}

model Payment {
  id            Int      @id @default(autoincrement())
  orderId       String   @unique
  paymentKey    String?  @unique
  amount        Int
  status        String   // READY, DONE, FAIL
  orderName     String
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatRoom {
  id        Int           @id @default(autoincrement())
  userId    Int
  title     String        @default("새 채팅")
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  role      String
  content   String
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id] ,onDelete: Cascade)
}